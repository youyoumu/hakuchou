{
  "name": "@repo/note",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite ./preview/anki",
    "build": "tsc -b && COMMIT_SHA=$(git rev-parse HEAD) vite build",
    "build:fast": "FAST_BUILD=true vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate-template": "vite-node ./script/generate-template.ts",
    "copy-anki-build": "vite-node ./script/copy-anki-build.ts",
    "update-note-type": "vite-node ./script/update-note-type.ts",
    "process-kanjivg": "node --experimental-strip-types ./preprocess/process-kanjivg.ts",
    "apply": "tsc -b && COMMIT_SHA=$(git rev-parse HEAD) vite build && vite-node ./script/generate-template.ts && vite-node ./script/copy-anki-build.ts && vite-node ./script/update-note-type.ts",
    "apply:fast": "FAST_BUILD=true vite build && vite-node ./script/generate-template.ts && vite-node ./script/copy-anki-build.ts && vite-node ./script/update-note-type.ts",
    "generate-apkg": "pnpm run apply && vite-node ./script/generate-apkg.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/serve-static": "^2.2.0",
    "chalk": "^5.6.2",
    "daisyui": "^5.5.20",
    "jsdom": "^29.1.1",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vite-node": "^6.0.0",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.7"
  }
}
